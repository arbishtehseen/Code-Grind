class Solution {
public:
    bool checkPerfectNumber(int num) {
        
        int temp = num;
        long long sum = 1; 
        for(long long i = 2 ; i*i <= temp ; i++){
            long long currentTermSum = 1;
            long long powTrack = 1;
            while( temp % i == 0 ){
                temp/=i;
                powTrack *= i;
                currentTermSum += powTrack;
            }
            sum *= currentTermSum;
        }
        if(temp > 1){
            sum *= (1 + temp);
        }

        if((sum-num) == num) return true;
        else return false;
    }
};
