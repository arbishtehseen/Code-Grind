#include<vector>
class Solution {
public:
    int kthFactor(int n, int k) {
        vector<int> divisor;
        for(int i = 1 ; i*i <= n ; i++){
            if( n%i == 0 ){
                divisor.push_back(i);
                if( i != n/i ){
                    divisor.push_back(n/i);
                }
            }
        }
        
        sort(divisor.begin(), divisor.end());

        if((k-1) >= divisor.size()){
            return -1;
        } else {
            return divisor[k-1];
        }
    }
};
