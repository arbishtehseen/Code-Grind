#include<vector>
class Solution {
public:
    int countPrimes(int n) {
        if ( n <= 2 ){
            return 0;
        }

     vector<bool> isPrime(n , true);
     isPrime[0] = false;
     isPrime[1] = false;
     int primes = 0;

     for(long long i = 2; i < n ; i++){
        if(isPrime[i]){
            primes++;
            for(long long j = 2*i ; j < n ; j += i){
                isPrime[j] = false;
            }
        }
     }
     return primes;
    }
};
