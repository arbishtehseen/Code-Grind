#include<iostream>
using namespace std;

class Node{
	public:
	int data;
	Node* next;
	
		Node(int val){
			data = val;
			next = nullptr;
		}
};

class Queue{
	Node* head;
	Node* tail;
	
	public:
		Queue(){
			head = tail = nullptr;
		}
		
		void enqueue(int val){
			Node* newNode = new Node(val); 
			
			if( head == nullptr ){
				head = tail = newNode;
			} else {
				tail->next = newNode;
				tail = newNode;
			}
		}
		
		void dequeue(){
			if ( head == nullptr ) return;
			else {
				Node* temp = head;
				head = temp->next;
				delete temp;
			}
		}
		
		int getFront(){
			return head->data;
		}
		
		bool isEmpty(){
			return head == nullptr;
		}
};
