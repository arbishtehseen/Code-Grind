// The API isBadVersion is defined for you.
// bool isBadVersion(int version);

class Solution {
public:
    int firstBadVersion(int n) {
        int left = 1;
        int right = n;
        int min = n;

        while( left <= right ){
            long long mid = left + (right - left)/2;
             bool result = isBadVersion(mid);
             if(result == false){
                left = mid + 1;
             } else {
                right = mid - 1;
                if( min > mid ){
                min = mid;
             }
            }
        }
       return min;
    }
};
