class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        double window_sum = 0.0;
        double max_avg = 0.0 ; 

        for(int i = 0 ; i < k  ; i++){
            window_sum += nums[i];
        }
        
        max_avg = window_sum / k ; 

        for(int i = k ; i < nums.size(); i++) {
            window_sum += (nums[i] - nums[i-k]);
            if( (window_sum / k ) > max_avg ){
                max_avg = window_sum/k ;
            }
        }
        return max_avg;
    }
};
