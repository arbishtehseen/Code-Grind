#include<unordered_set>
class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        int left = 0;  
        unordered_set<char> seen;
        int max_len = 0;

        for(int right = 0 ; right < s.length() ; right++) {
            while(seen.count(s[right])){
                seen.erase(s[left]);
                left++;
            }
            seen.insert(s[right]);
            if ( max_len < seen.size() ){
                max_len = seen.size();
            }
        }
        return max_len;
    }
};
