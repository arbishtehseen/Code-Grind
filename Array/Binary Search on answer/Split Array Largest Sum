
class Solution {
public:
    int splitArray(vector<int>& nums, int k) {
        int low = *max_element(nums.begin() , nums.end());
        long long high = 0;
        for(int i = 0 ; i < nums.size() ; i++) {
            high += nums[i] ;
        }
        while( low <= high ) {
            long long current_sum = 0;
            int tar = 1;
            long long mid = low + (high - low)/2;

            for(int i = 0 ; i < nums.size() ; i++) {
                if( (current_sum += nums[i]) > mid ) {
                    current_sum = nums[i];
                    tar++;
                }
            }
            if ( tar <= k ) {
                high = mid - 1;
            } else {
               low = mid + 1;
            }
        }
        return low;
        
    }
};
