
class Solution {
public:
    int minEatingSpeed(vector<int>& piles, int h) {
        int low = 1; 
        int high = *max_element(piles.begin(), piles.end());

        int min_k = high;
        while( low <= high ) {
            long long k = low + (high - low)/2;
            long long total_hours = 0; 

            for(int i = 0 ; i < piles.size() ; i++){
                total_hours += (piles[i]/k);
                if( piles[i] % k != 0 || piles[i] < k ){
                    total_hours++;
                }
            }
            if( total_hours <= h ){
                high = k - 1;
                if( min_k > k ){
                    min_k = k ;
            }
            } else {
                low = k + 1; 
            }
        }
        return min_k ;
    }
};
