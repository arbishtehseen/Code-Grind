#include<algorithm>
class Solution {
public:
    vector<vector<int>> threeSum(vector<int>& nums) {
       sort(nums.begin(), nums.end());
       vector<vector<int>> result;
       
       for(int row = 0 ; row < (nums.size() - 2) ; row++){
        if (row > 0 && nums[row] == nums[row - 1]){
             continue; 
           }
           int fix = nums[row];
           int left = row + 1;
           int right = nums.size() - 1;
            while(left < right){
              if(nums[left] + nums[right] + fix == 0){
                    result.push_back({fix, nums[left], nums[right]});
                    while (left < right && nums[left] == nums[left + 1]) {
                        left++;
                    }
                    while (left < right && nums[right] == nums[right - 1]) {
                        right--;
                    }
                    left++;
                    right--;
                }
              
              else if(nums[left] + nums[right] + fix < 0){
                left++;
              }
              else{
                right--;
              }
           }
       }
         return result;
    }
};
