class Solution {
public:
    int maxArea(vector<int>& height) {
        int left = 0;
        int right = height.size() - 1;
        int maxArea = 0;
        int w , h , area;

        while(left < right){
            w = right - left;
            if(height[left] < height[right]){
                h = height[left];
            }
            else {
                h = height[right];
            }
            if(maxArea < (w*h)){
                maxArea = w*h;
            }

            if(height[right] > height[left]){
                left++;
            }
            else{
                right--;
            }
        }
        return maxArea;
        
    }
};
