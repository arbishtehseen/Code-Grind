#include<iostream>
#include<vector>
using namespace std;

class Stack {
	private : 
	vector<int> v;
	
	public : 
	void push_stack(int val) {
		v.push_back(val);
	}
	
	void pop_back() {
		v.pop_back();
	}
	
	int getTop(){
		return v[v.size()-1];
	}
	
	void print_stack(){
		for(int i = 0 ; i < v.size() ; i++){
			cout << v[i] <<" ";
		}
		cout << endl;
	}
	
	bool isEmpty() {
		if(v.size() >= 1) {
			return false;
		} else {
			return true;
		}
	}
};

int main() {
	Stack s1;
	s1.push_stack(10); 
	s1.push_stack(20); 
	s1.push_stack(30); 
	s1.push_stack(40); 
	s1.push_stack(50); 
// 	s1.print_stack();
//	s1.pop_back();
//  s1.print_stack();
	
	while(!s1.isEmpty()){
		cout << s1.getTop() << endl;
		s1.pop_back();
	}
	
	
	return 0;
}
