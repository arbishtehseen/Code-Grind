class Solution {
public:
    vector<int> corpFlightBookings
    (vector<vector<int>>& bookings, int n) {
        vector<int> answer(n + 2, 0); 
        
        for(int i = 0 ; i < bookings.size() ; i++){
            int val = bookings[i][2];
            int L = bookings[i][0];
            int R = bookings[i][1];
            answer[L] += val;
            answer[R+1] -=val;
        }
        
        for(int i = 1 ; i <= n ; i++){
           answer[i] += answer[i-1];
        }
        return vector<int> (answer.begin() + 1, answer.begin() + 1 + n);
    }
};
