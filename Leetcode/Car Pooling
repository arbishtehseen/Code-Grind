class Solution {
public:
    bool carPooling(vector<vector<int>>& trips, int capacity) {
        vector<long long> pf(1001, 0);
        for(int i = 0 ; i < trips.size(); i++){
            int num_of_passenger = trips[i][0];
            int L = trips[i][1];
            int R = trips[i][2]; 
            pf[L] += num_of_passenger;
            pf[R] -= num_of_passenger;
        }
        if(pf[0] > capacity){
            return false;
        }
        for(long long i = 1 ; i < pf.size() ; i++){
            pf[i] += pf[i-1]; 
            if(pf[i] > capacity){
                return false;
            }
        }
        return true;
    }
};
