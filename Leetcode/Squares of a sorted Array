class Solution {
public:
    vector<int> sortedSquares(vector<int>& nums) {
        for(int i = 0; i < nums.size(); i++){
            nums[i]*=nums[i];
        }
        int left = 0;
        int right = nums.size() - 1;
        vector<int> result(nums.size());
        int pos = nums.size() - 1;

        while(left <= right){
            if (nums[right] >= nums[left]) { 
                result[pos] = nums[right];
                right--;
            } else {
                result[pos] = nums[left];
                left++;
            }
            pos--;
    }
    return result;
    }
};
