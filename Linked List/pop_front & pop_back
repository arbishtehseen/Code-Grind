void pop_front(){
		if(head == NULL){
			return;
		} else {
			Node* temp = head;
			head = head->next; 
			temp->next = NULL;
			delete temp;
		}
	}
	
	void pop_back(){
		
		if(head == NULL){
			return;
		}
		
		if( head == tail ){
			delete head;
			head = tail = NULL;
			return;
		}
		
		Node* temp = head;
		while(temp->next != tail){
			temp = temp->next; 
		}
		delete tail;
		tail = temp;
		tail->next = NULL;	
	}
	
