class Solution {
public:
    ListNode* addTwoNumbers(ListNode* l1, ListNode* l2) {
        string s1 = "";
        ListNode* temp1 = l1;
        while (temp1 != NULL) {
            s1 += to_string(temp1->val);
            temp1 = temp1->next;
        }

        string s2 = "";
        ListNode* temp2 = l2;
        while (temp2 != NULL) {
            s2 += to_string(temp2->val);
            temp2 = temp2->next;
        }

        string result = "";
        int i = 0, j = 0, carry = 0;
        while (i < s1.length() || j < s2.length() || carry) {
            int sum = carry;
            if (i < s1.length()) sum += s1[i++] - '0';
            if (j < s2.length()) sum += s2[j++] - '0';
            carry = sum / 10;
            result += to_string(sum % 10);
        }

        int k = 0;
        ListNode* head = new ListNode(result[k] - '0');
        ListNode* l3 = head;
        k++;

        while (k < result.length()) {
            l3->next = new ListNode(result[k] - '0');
            l3 = l3->next;
            k++;
        }

        return head;
    }
};
